<div class="container">
  <p>
  <h2>Fill the form below to create a new restaurant</h2>
    <div class="mb-3">
        <%= simple_form_for(@restaurant) do |f| %>
          <%= f.input :name %>
          <%= f.input :phone_number %>
          <%= f.input :address %>
          <%= f.input :category, collection: Restaurant::CATEGORIES %>
          <%= f.submit %>
        <% end %>
    </div>
  </p>
</div>
